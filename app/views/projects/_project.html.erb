<div id="<%= dom_id project %>">
  <p>
    <strong>Team:</strong>
    <%= project.team_id %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= project.name %>
  </p>

  <p>
    <strong>Goal:</strong>
    <%= project.goal %>
  </p>

  <p>
    <strong>Deadline:</strong>
    <%= project.deadline %>
  </p>

  <p>
    <strong>Priority:</strong>
    <%= project.priority %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= project.status %>
  </p>

</div>
